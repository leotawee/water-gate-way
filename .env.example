# Copy to .env.local (Next.js) and export for the Python/Node services.
# Placeholders only. Never commit real values.

# --- PostgreSQL (mqtt_bridge.js, Next.js API routes). All required by mqtt_bridge.js ---
PGUSER=change_me_db_user
PGHOST=127.0.0.1
PGDATABASE=change_me_db_name
PGPASSWORD=change_me_db_password
PGPORT=5432

# --- MQTT bridge (mqtt_bridge.js). MQTT_BROKER is required ---
MQTT_BROKER=mqtt://127.0.0.1:1883
MQTT_TOPIC=watergate/telemetry
MQTT_QOS=1
# Broker login for the bridge process (read-only account "bridge"); set in that process's own env.
# Never put credentials inside MQTT_BROKER (it is logged).
# MQTT_USER=bridge
# MQTT_PASS=change_me

# --- AI receiver (ai-receiver/main.py). MQTT_HOST is required ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Broker login for the ai-receiver process (account "ai_receiver": reads the control topic,
# writes the status topic); set in that process's own env.
# MQTT_USER=ai_receiver
# MQTT_PASS=change_me
MQTT_TOPIC_CONTROL=water/gate/control
MQTT_TOPIC_STATUS=water/gate/status
WGW_SERIAL_PORT=/dev/ttyS0
# Shared secret (>= 32 chars) for X-Control-Token on ai-receiver's POST /api/control and /api/update-count.
# Used by ai-receiver (FastAPI) only: the Next.js app publishes commands to MQTT and does not call it.
# FastAPI refuses to start without it. Generate: openssl rand -base64 48
CONTROL_SHARED_SECRET=change_me_32_bytes_min
API_HOST=127.0.0.1

# --- Next.js dashboard (server-side only; no NEXT_PUBLIC_* variables) ---

# Server-side MQTT connection (never exposed to the browser): subscribes to the status topics for
# GET /api/status/stream and publishes operator commands to stm32/cmd for POST /api/control.
# Also subscribes to MQTT_TOPIC_STATUS above when set. The broker account needs read on the
# status topics and write on stm32/cmd only.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=nextjs
MQTT_PASSWORD=change_me
# go2rtc API for GET /api/camera/stream (HTTP video; server-side only, the browser never sees it).
GO2RTC_URL=http://127.0.0.1:1984
# Which header holds the real client IP (login/control rate limits, audit log).
# Unset: X-Forwarded-For (nginx must overwrite it). Behind Cloudflare Tunnel: cf-connecting-ip.
# Set cf-connecting-ip ONLY when the app listens on 127.0.0.1 and nothing but cloudflared reaches it,
# otherwise a client can send its own CF-Connecting-IP and pick any IP.
# CLIENT_IP_HEADER=cf-connecting-ip
