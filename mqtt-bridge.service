# Water Gate Way - MQTT-to-PostgreSQL Bridge Systemd Service
# ============================================================
#
# Install:
#   1. Copy this file to /etc/systemd/system/mqtt-bridge.service
#   2. Edit paths and environment variables below to match your server
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now mqtt-bridge
#
# Manage:
#   sudo systemctl status  mqtt-bridge
#   sudo systemctl start   mqtt-bridge
#   sudo systemctl stop    mqtt-bridge
#   sudo systemctl restart mqtt-bridge
#   sudo journalctl -u mqtt-bridge -f

[Unit]
Description=Water Gate Way - MQTT to PostgreSQL Bridge
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/water-gate-way
ExecStart=/usr/bin/node /home/ubuntu/water-gate-way/mqtt_bridge.js
Restart=always
RestartSec=5

# Environment variables (adjust to your setup)
Environment="NODE_ENV=production"
Environment="MQTT_BROKER=mqtt://178.128.49.254:1883"
Environment="MQTT_TOPIC=watergate/telemetry"
Environment="MQTT_QOS=1"
Environment="PGUSER=water_admin"
Environment="PGHOST=172.17.0.2"
Environment="PGDATABASE=watergate_db"
Environment="PGPASSWORD=zxc123"
Environment="PGPORT=5432"

# Optional: load from an env file instead
# EnvironmentFile=/home/ubuntu/water-gate-way/.env.bridge

[Install]
WantedBy=multi-user.target
