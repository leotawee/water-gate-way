# Water Gate Way - MQTT-to-PostgreSQL Bridge Systemd Service
# ============================================================
#
# Install:
#   1. Copy this file to /etc/systemd/system/mqtt-bridge.service (template: never commit real values)
#   2. Edit paths and environment variables below to match your server
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now mqtt-bridge
#
# Manage:
#   sudo systemctl status  mqtt-bridge
#   sudo systemctl start   mqtt-bridge
#   sudo systemctl stop    mqtt-bridge
#   sudo systemctl restart mqtt-bridge
#   sudo journalctl -u mqtt-bridge -f

[Unit]
Description=Water Gate Way - MQTT to PostgreSQL Bridge
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/water-gate-way
ExecStart=/usr/bin/node /home/<USER>/water-gate-way/mqtt_bridge.js
Restart=always
RestartSec=5

# WHY: secrets live in an env file (mode 600), never in this unit or in git.
# The file holds: NODE_ENV, MQTT_BROKER, MQTT_TOPIC, MQTT_QOS, MQTT_USER, MQTT_PASS,
# PGUSER, PGHOST, PGDATABASE, PGPASSWORD, PGPORT (see .env.example).
EnvironmentFile=/home/<USER>/water-gate-way/.env.bridge

[Install]
WantedBy=multi-user.target
