# คัดลอกเป็น .env แล้วกรอกค่าจริง — ห้าม commit ไฟล์ .env (มีรหัสกล้อง/broker)
# ใช้ stream จาก go2rtc บน Pi เอง (office1/office2/office3) ไม่ต้องใส่รหัสกล้อง
WGW_RTSP_URL=rtsp://127.0.0.1:8554/office1

# ค่าตั้งต้นที่ตกลงกัน — แก้ได้โดยไม่ต้องแก้โค้ด
# 0.7 missed a person seen close-up and tilted (scores 0.5-0.9); empty scenes score <= 0.03
WGW_CONF=0.35
WGW_SIZE=320
WGW_DEBOUNCE=5.0
WGW_MIN_HITS=2
WGW_BIND=127.0.0.1
WGW_PORT=8080

# MQTT (ทาง 2: ยิงจำนวนคนขึ้น dashboard ตรงเข้า broker บน droplet)
# เว้น WGW_MQTT_HOST ว่าง = โหมดพรีวิวอย่างเดียว ไม่ต่อ broker
# แนะนำใช้ Tailscale IP ของ droplet (100.119.218.124) ไม่ใช่ IP สาธารณะ
WGW_MQTT_HOST=100.119.218.124
WGW_MQTT_PORT=1883
WGW_MQTT_USER=pi_gate
WGW_MQTT_PASS=
WGW_MQTT_TOPIC=water/gate/person
# ยิงซ้ำทุก N วินาทีแม้ค่าไม่เปลี่ยน (heartbeat กันตัวเลขค้างเมื่อ Pi ตาย)
WGW_HEARTBEAT=5.0
# Pi 4 ที่ไฟเลี้ยงตกง่าย: ให้ inference เบา
WGW_THREADS=1
WGW_MAX_FPS=1.5
